# SQLite (default for local dev – no server required)
DATABASE_URL="file:./dev.db"

# Or use PostgreSQL (change prisma/schema.prisma provider to "postgresql" first):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/opticore?schema=public"

# Auth.js v5 uses AUTH_SECRET (must be at least 32 characters)
# For local dev you can use the placeholder below; for production generate a strong random secret.
AUTH_SECRET="opticore-dev-secret-minimum-32-characters-long"

NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
