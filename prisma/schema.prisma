generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role
  passwordHash String?
  department   String?
  collegeId    String?
  programId    String?
  sectionId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  college   College? @relation(fields: [collegeId], references: [id])
  program   Program? @relation(fields: [programId], references: [id])
  section   Section? @relation(fields: [sectionId], references: [id])

  facultyProfile FacultyProfile?
  schedules      Schedule[]
  requests       ScheduleChangeRequest[]

  // Workflow relations
  createdSubjectOfferings SubjectOffering[]        @relation("CreatedOfferings")
  subjectOfferingPrefs    SubjectOfferingInstructor[]
  submittedDrafts         ScheduleDraft[]          @relation("submittedDrafts")
  approvedDrafts          ScheduleDraft[]          @relation("approvedDrafts")
  workflowComments        WorkflowComment[]
  auditLogs               AuditLog[]

  // Draft entries where this user is instructor
  scheduleEntriesAsInstructor ScheduleEntry[] @relation("EntryInstructor")
}

enum Role {
  DOI            // Dean of Instructions (campus-wide)
  COLLEGE_ADMIN  // One per college (COTE, CAFE, COED, CAS, CHTM)
  CHAIRMAN_ADMIN // Program/Major chair (e.g., BSIT, BIT-Automotive)
  INSTRUCTOR     // Teaching faculty
  STUDENT
  VISITOR        // Guest, map-only access
}

model College {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String
  programs Program[]
  users    User[]

  scheduleDrafts ScheduleDraft[]
}

model Program {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  collegeId String
  college   College   @relation(fields: [collegeId], references: [id])

  sections  Section[]
  users     User[]

   subjectOfferings SubjectOffering[]
}

model FacultyProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  fullName         String
  bsDegree         String
  msDegree         String?
  status           String
  designation      String?
  canTeach         FacultyCanTeach[]
}

// SQLite does not support primitive arrays (String[]). Use a join table instead.
// If you later switch to PostgreSQL, you can keep this join table (recommended),
// or refactor to an array field if you prefer.
model FacultyCanTeach {
  id              String         @id @default(cuid())
  facultyProfileId String
  facultyProfile  FacultyProfile @relation(fields: [facultyProfileId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([facultyProfileId, subjectId])
}

model Section {
  id           String    @id @default(cuid())
  programId    String
  program      Program   @relation(fields: [programId], references: [id])
  name         String
  yearLevel    Int
  studentCount Int       @default(40)
  schedules    Schedule[]

  @@unique([programId, name])

  draftEntries ScheduleEntry[]
  students     User[]
}

model Subject {
  id           String       @id @default(cuid())
  code         String       @unique
  title        String
  units        Float
  lecHours     Float
  labHours     Float
  type         SubjectType
  college      String?
  prerequisite String?
  schedules    Schedule[]
  canBeTaughtBy FacultyCanTeach[]

  offerings    SubjectOffering[]
  draftEntries ScheduleEntry[]
}

enum SubjectType {
  GEC
  DEPARTMENTAL
}

model Room {
  id        String    @id @default(cuid())
  code      String    @unique
  building  String
  floor     Int
  capacity  Int
  type      RoomType
  schedules Schedule[]

  draftEntries ScheduleEntry[]
}

enum RoomType {
  LECTURE
  LAB
}

model Schedule {
  id           String         @id @default(cuid())
  subjectId    String
  subject      Subject        @relation(fields: [subjectId], references: [id])
  instructorId String
  instructor   User           @relation(fields: [instructorId], references: [id])
  sectionId    String
  section      Section        @relation(fields: [sectionId], references: [id])
  roomId       String
  room         Room           @relation(fields: [roomId], references: [id])
  day          DayOfWeek
  startTime    String
  endTime      String
  status       ScheduleStatus @default(DRAFT)
  semester     String
  academicYear String

  changeRequests ScheduleChangeRequest[]
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum ScheduleStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// Academic periods (e.g., 1st Sem 2025–2026)
model AcademicPeriod {
  id           String          @id @default(cuid())
  name         String
  semester     String
  academicYear String
  isCurrent    Boolean         @default(false)

  subjectOfferings SubjectOffering[]
  scheduleDrafts   ScheduleDraft[]
}

// Chairman Admin subject offerings for a program/major in a given period
model SubjectOffering {
  id               String          @id @default(cuid())
  programId        String
  academicPeriodId String
  subjectId        String
  createdById      String

  estimatedSections        Int      @default(1)
  estimatedStudentsPerSection Int   @default(40)

  preferredDays      String?       // e.g. "MONDAY,WEDNESDAY"
  preferredTimeOfDay String?       // e.g. "MORNING", "AFTERNOON"
  preferredRoomType  RoomType?

  program        Program        @relation(fields: [programId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  subject        Subject        @relation(fields: [subjectId], references: [id])
  createdBy      User           @relation("CreatedOfferings", fields: [createdById], references: [id])

  preferredInstructors SubjectOfferingInstructor[]
}

// Join table: preferred instructors per offering
model SubjectOfferingInstructor {
  id               String          @id @default(cuid())
  subjectOfferingId String
  instructorId     String

  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)
  instructor      User            @relation(fields: [instructorId], references: [id])

  @@unique([subjectOfferingId, instructorId])
}

// College-level schedule draft with workflow states
model ScheduleDraft {
  id               String             @id @default(cuid())
  collegeId        String
  academicPeriodId String
  version          Int                @default(1)
  status           ScheduleDraftStatus @default(DRAFT)

  submittedById String?
  approvedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college        College        @relation(fields: [collegeId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  submittedBy    User?          @relation("submittedDrafts", fields: [submittedById], references: [id])
  approvedBy     User?          @relation("approvedDrafts", fields: [approvedById], references: [id])

  entries   ScheduleEntry[]
  comments  WorkflowComment[]
  auditLogs AuditLog[]
}

enum ScheduleDraftStatus {
  DRAFT
  CAS_REVIEW
  DOI_REVIEW
  RETURNED
  APPROVED
  PUBLISHED
}

// Individual entries within a draft (conflict-aware, before publishing)
model ScheduleEntry {
  id         String   @id @default(cuid())
  draftId    String
  subjectId  String
  instructorId String
  sectionId  String
  roomId     String
  day        DayOfWeek
  startTime  String
  endTime    String

  draft      ScheduleDraft @relation(fields: [draftId], references: [id])
  subject    Subject       @relation(fields: [subjectId], references: [id])
  instructor User          @relation("EntryInstructor", fields: [instructorId], references: [id])
  section    Section       @relation(fields: [sectionId], references: [id])
  room       Room          @relation(fields: [roomId], references: [id])
}

// Comments required on every forward/return in the workflow
model WorkflowComment {
  id        String         @id @default(cuid())
  draftId   String
  authorId  String
  action    WorkflowAction
  message   String
  createdAt DateTime       @default(now())

  draft  ScheduleDraft @relation(fields: [draftId], references: [id])
  author User          @relation(fields: [authorId], references: [id])
}

enum WorkflowAction {
  TO_CAS
  TO_DOI
  RETURN_TO_COLLEGE
  RETURN_TO_CAS
  APPROVE
  PUBLISH
}

// Simple audit log for schedule-related changes
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  draftId   String?
  entity    String   // e.g. "ScheduleDraft", "ScheduleEntry", "SubjectOffering"
  entityId  String
  action    String
  details   String?
  createdAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id])
  draft ScheduleDraft? @relation(fields: [draftId], references: [id])
}

model ScheduleChangeRequest {
  id           String        @id @default(cuid())
  requesterId  String
  requester    User          @relation(fields: [requesterId], references: [id])
  scheduleId   String?
  schedule     Schedule?     @relation(fields: [scheduleId], references: [id])
  reason       String
  newStartTime String?
  newRoomId    String?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

